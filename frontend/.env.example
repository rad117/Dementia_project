# Copy to .env.local to point the frontend at the real backend instead of
# the built-in mock API (frontend/src/services/mockApi.js).
#
# Every endpoint the frontend calls (patient screening flow, clinician
# dashboard/patients/assessment-detail/compare, safety monitor, /auth/*)
# exists on the backend. Auth is real: participants sign in with a
# per-patient login code (e.g. PT-1001), clinicians with
# dr.sharma@memora.org / demo1234 -- both seeded by backend/seed.py.
VITE_USE_MOCK_API=false
VITE_API_BASE_URL=http://127.0.0.1:8000
