# Copy to .env.local to point the frontend at the real backend instead of
# the built-in mock API (frontend/src/services/mockApi.js).
#
# Every endpoint the frontend calls (patient screening flow, clinician
# dashboard/patients/assessment-detail/compare, /auth/*) now exists on the
# backend. Auth and patient management are still DEMO STUBS though --
# /auth/participant and /auth/clinical accept any credentials, and /patients
# always returns a single hardcoded "demo-patient" (see
# backend/routes/demo_auth.py). Real multi-patient auth is separate,
# larger, future scope.
VITE_USE_MOCK_API=false
VITE_API_BASE_URL=http://127.0.0.1:8000
