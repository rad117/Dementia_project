# Copy to .env.local to point the frontend at the real backend instead of
# the built-in mock API (frontend/src/services/mockApi.js).
#
# This only makes the PATIENT SCREENING FLOW real (Language -> Task ->
# Recording -> Processing -> Complete). The clinician dashboard/login pages
# (Dashboard, Patients, PatientProfile, AssessmentDetail, AssessmentCompare,
# PatientLogin) call endpoints (/patients, /auth/*, etc.) the backend does
# not implement yet -- those will fail against a real backend by design
# until that (larger, separate) ticket lands.
VITE_USE_MOCK_API=false
VITE_API_BASE_URL=http://127.0.0.1:8000
